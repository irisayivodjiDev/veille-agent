# Serveur
PORT=8080
REQUIRE_AUTH=false

# LM Studio (modèle local, serveur OpenAI-compatible)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=dolphin3.0-llama3.1-8b

# Base de données de l'app de veille (séparée du checkpointer LangGraph)
APP_DB_PATH=state_db/veille.db

# Bot Telegram (capture) — créer un bot via @BotFather sur Telegram pour obtenir ce token
# Si absent, le bot ne démarre pas mais le formulaire web reste utilisable.
TELEGRAM_BOT_TOKEN=
